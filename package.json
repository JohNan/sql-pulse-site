{
  "name": "sql-pulse-marketing-site",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "postbuild": "node -e \"const fs=require('fs'),p='dist/sql-pulse-marketing-site/browser';if(fs.existsSync(p+'/index.html')){for(const r of ['features','security','privacy-policy','terms']){fs.mkdirSync(p+'/'+r,{recursive:true});fs.copyFileSync(p+'/index.html',p+'/'+r+'/index.html');}fs.copyFileSync(p+'/index.html',p+'/404.html');fs.copyFileSync('public/.htaccess',p+'/.htaccess');}\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "knip": "knip"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.2.0",
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^9.39.3",
    "angular-eslint": "21.2.0",
    "eslint": "^9.39.2",
    "jsdom": "^28.0.0",
    "knip": "^5.85.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.50.1",
    "vitest": "^4.0.8"
  }
}
